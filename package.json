{
  "name": "antoniomdm-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "build:web": "astro build",
    "build:godot": "node scripts/build-godot.mjs",
    "build:release": "npm run build:godot && npm run build",
    "preview": "astro preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:performance": "node scripts/lighthouse.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.12.0",
    "lighthouse": "13.4.1",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
