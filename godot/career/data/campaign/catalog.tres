			}
		]
	},
	{
		"id": "alcatel-desk",
		"target": "urgent-desk",
		"seconds": 90,
		"mechanic": "bug",
		"title": {
			"es": "Una fibra sin destino",
			"en": "A fiber without a destination"
		},
		"briefing": {
			"es": "El equipo de B-12 detecta que el diseño admite una fibra sin destino. ¿Qué validación debe bloquear la publicación?",
			"en": "The B-12 team finds that the design permits a fiber with no destination. Which validation must block publication?"
		},
		"choices": [
			{
				"id": "alcatel-desk-0",
				"label": {
					"es": "Validar que ambos extremos referencian nodos existentes",
					"en": "Validate that both ends reference existing nodes"
				},
				"accepted": true,
				"feedback": {
					"es": "Una conexión necesita extremos válidos; el aspecto del plano no garantiza continuidad.",
					"en": "A connection needs valid endpoints; the drawing’s appearance does not guarantee continuity."
				}
			},
			{
				"id": "alcatel-desk-1",
				"label": {
					"es": "Ocultar la fibra en el dibujo",
					"en": "Hide the fiber in the drawing"
				},
				"accepted": false,
				"feedback": {
					"es": "La fibra sigue sin destino en el modelo aunque no se vea.",
					"en": "The fiber still has no destination in the model even if it is hidden."
				}
			},
			{
				"id": "alcatel-desk-2",
				"label": {
					"es": "Cambiar el color del cable",
					"en": "Change the cable color"
				},
				"accepted": false,
				"feedback": {
					"es": "El color no crea el extremo que falta; el diseño sigue inválido.",
					"en": "Color does not create the missing endpoint; the design remains invalid."
				}
			}
		]
	},
	{
		"id": "alcatel-statue",
		"target": "statue",
		"seconds": 75,
		"mechanic": "routing",
		"title": {
			"es": "Calcular el material del tendido",
			"en": "Calculate cabling materials"
		},
		"briefing": {
			"es": "El diseño validado incluye tramos de distinta longitud y material. ¿Cómo calculas cuánto comprar de cada material?",
			"en": "The validated design contains segments of different lengths and materials. How do you calculate how much of each material to buy?"
		},
		"choices": [
			{
				"id": "alcatel-statue-0",
				"label": {
					"es": "Número de tramos por el más largo",
					"en": "Segment count times the longest segment"
				},
				"accepted": false,
				"feedback": {
					"es": "Asignas a todos los tramos la longitud máxima y sobreestimas el material.",
					"en": "You assign the maximum length to every segment and overestimate materials."
				}
			},
			{
				"id": "alcatel-statue-1",
				"label": {
					"es": "Sumar longitudes válidas agrupadas por material",
					"en": "Sum valid lengths grouped by material"
				},
				"accepted": true,
				"feedback": {
					"es": "El presupuesto depende de cantidades y materiales del diseño validado.",
					"en": "The estimate depends on quantities and materials in the validated design."
				}
			},
			{
				"id": "alcatel-statue-2",
				"label": {
					"es": "Usar una longitud media global para cada material",
					"en": "Use a global average length for each material"
				},
				"accepted": false,
				"feedback": {
					"es": "La media global mezcla materiales distintos y pierde sus cantidades reales.",
					"en": "The global average mixes different materials and loses their actual quantities."
				}
			}
		]
	},
	{
		"id": "alcatel-platform",
		"target": "review",
		"seconds": 75,
		"mechanic": "architecture",
		"title": {
			"es": "De herramientas sueltas a plataforma",
			"en": "From separate tools to a platform"
		},
		"briefing": {
			"es": "Dos herramientas calculan distinto la misma regla de cableado. ¿Cómo reduces la divergencia?",
			"en": "Two tools calculate the same cabling rule differently. How do you reduce divergence?"
		},
		"choices": [
			{
				"id": "alcatel-platform-0",
				"label": {
					"es": "Copiar una tercera versión",
					"en": "Copy a third version"
				},
				"accepted": false,
				"feedback": {
					"es": "Añades otra copia que también puede divergir cuando cambie la regla.",
					"en": "You add another copy that can also diverge when the rule changes."
				}
			},
			{
				"id": "alcatel-platform-1",
				"label": {
					"es": "Aceptar ambos resultados",
					"en": "Accept both results"
				},
				"accepted": false,
				"feedback": {
					"es": "El mismo diseño sigue produciendo resultados incompatibles.",
					"en": "The same design still produces incompatible results."
				}
			},
			{
				"id": "alcatel-platform-2",
				"label": {
					"es": "Acordar la regla, centralizarla y probar casos comunes",
					"en": "Agree the rule, centralize it and test common cases"
				},
				"accepted": true,
				"feedback": {
					"es": "Compartir comportamiento de dominio evita que cada interfaz invente su propia regla.",
					"en": "Shared domain behavior prevents each interface from inventing its own rule."
				}
			}
		]
	},
	{
