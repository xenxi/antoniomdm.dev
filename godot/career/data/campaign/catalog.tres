		"seconds": 75,
		"mechanic": "bug",
		"title": {
			"es": "Cobertura sin atajos",
			"en": "Coverage without shortcuts"
		},
		"briefing": {
			"es": "Un tramo cruza el borde de una zona de cobertura. ¿Qué pruebas hacen falta para la intersección?",
