[gd_resource type="Resource" script_class="CampaignCatalog" load_steps=2 format=3]
[ext_resource type="Script" path="res://systems/quest/campaign_catalog.gd" id="1"]
[resource]
script = ExtResource("1")
chapters = Array[Dictionary]([
	{
		"id": "freelance",
		"experienceId": "freelance",
		"scenario": "bedroom",
