			},
			{
				"id": "nokia-connectivity-2",
				"label": {
					"es": "Que el dibujo esté centrado",
					"en": "That the drawing is centered"
				},
				"accepted": false,
				"feedback": {
					"es": "Centrar el plano no enlaza los extremos desconectados.",
					"en": "Centering the drawing does not link disconnected endpoints."
				}
			}
		]
	},
