	},
	{
		"id": "vector-nlp",
		"target": "review",
		"seconds": 75,
		"mechanic": "trace",
		"title": {
			"es": "Palabras con contexto",
			"en": "Words with context"
		},
		"briefing": {
			"es": "Un clasificador de sentimiento debe evaluarse. ¿Qué evita medirlo con respuestas que ya ha visto?",
			"en": "A sentiment classifier needs evaluation. What avoids measuring it against answers it has already seen?"
		},
		"choices": [
			{
				"id": "vector-nlp-0",
				"label": {
					"es": "Separar entrenamiento y evaluación antes de ajustar",
					"en": "Separate training and evaluation before fitting"
				},
				"accepted": true,
				"feedback": {
					"es": "Reserva datos de evaluación independientes para estimar la generalización.",
					"en": "Hold out independent evaluation data to estimate generalization."
				}
			},
			{
				"id": "vector-nlp-1",
				"label": {
					"es": "Entrenar y evaluar con los mismos textos",
					"en": "Train and evaluate on the same texts"
				},
				"accepted": false,
				"feedback": {
					"es": "La evaluación reutiliza ejemplos aprendidos y sobreestima el resultado.",
					"en": "Evaluation reuses learned examples and overestimates performance."
				}
			},
			{
				"id": "vector-nlp-2",
				"label": {
					"es": "Eliminar todos los ejemplos difíciles",
					"en": "Remove every difficult example"
				},
				"accepted": false,
				"feedback": {
					"es": "Excluir casos difíciles sesga la evaluación frente al uso real.",
					"en": "Excluding difficult cases biases evaluation against real use."
				}
			}
		]
	},
	{
		"id": "vector-workflow",
		"target": "team",
		"seconds": 75,
		"mechanic": "priority",
		"title": {
			"es": "Automatización que se puede detener",
			"en": "Automation you can stop"
		},
		"briefing": {
			"es": "Una campaña automática supera su límite configurado. ¿Qué debería hacer el flujo?",
			"en": "An automated campaign exceeds its configured limit. What should the workflow do?"
		},
		"choices": [
			{
				"id": "vector-workflow-0",
				"label": {
					"es": "Seguir indefinidamente",
					"en": "Continue indefinitely"
				},
				"accepted": false,
				"feedback": {
					"es": "El flujo continúa consumiendo recursos por encima del límite.",
					"en": "The workflow keeps consuming resources above the limit."
				}
			},
			{
				"id": "vector-workflow-1",
				"label": {
					"es": "Ocultar el consumo",
					"en": "Hide consumption"
				},
				"accepted": false,
				"feedback": {
					"es": "El exceso sigue ocurriendo y el equipo pierde visibilidad para detenerlo.",
					"en": "The overrun continues and the team loses visibility needed to stop it."
				}
			},
			{
				"id": "vector-workflow-2",
				"label": {
					"es": "Detener la acción, registrar el motivo y avisar",
					"en": "Stop the action, record the reason and notify"
				},
				"accepted": true,
				"feedback": {
					"es": "Los límites y la trazabilidad hacen que la automatización sea controlable.",
					"en": "Limits and traceability make automation controllable."
				}
			}
		]
	},
	{
		"id": "anexia-requirements",
		"target": "team",
		"seconds": 75,
		"mechanic": "priority",
		"title": {
			"es": "Diez mesas, un producto entero",
			"en": "Ten desks, a whole product"
		},
		"briefing": {
			"es": "Un cliente pide «gestionar llaves». ¿Qué convierte esa frase en un requisito implementable?",
			"en": "A client asks to “manage keys”. What turns that phrase into an implementable requirement?"
		},
		"choices": [
			{
				"id": "anexia-requirements-0",
				"label": {
					"es": "Definir primero el esquema de datos sin validar el flujo",
					"en": "Define the data schema before validating the workflow"
				},
				"accepted": false,
				"feedback": {
					"es": "El esquema no aclara quién puede entregar o recibir una llave.",
					"en": "The schema does not clarify who may hand over or receive a key."
				}
			},
			{
				"id": "anexia-requirements-1",
				"label": {
					"es": "Aclarar quién entrega, recibe y registra cada movimiento",
					"en": "Clarify who hands over, receives and records each movement"
				},
				"accepted": true,
				"feedback": {
					"es": "Actores, estados y criterios de aceptación guían el diseño de extremo a extremo.",
					"en": "Actors, states and acceptance criteria guide end-to-end design."
				}
			},
			{
				"id": "anexia-requirements-2",
				"label": {
					"es": "Crear una tabla sin preguntar",
					"en": "Create a table without asking"
				},
				"accepted": false,
				"feedback": {
					"es": "La tabla fija supuestos que el cliente todavía no ha validado.",
					"en": "The table locks in assumptions the client has not validated."
				}
			}
		]
	},
	{
		"id": "anexia-mobile",
		"target": "device",
		"seconds": 75,
		"mechanic": "architecture",
		"title": {
			"es": "Del móvil a producción",
			"en": "From mobile to production"
		},
		"briefing": {
			"es": "La app Flutter envía dos veces una operación al reconectar. ¿Qué protege la operación en el servidor?",
			"en": "The Flutter app sends an operation twice after reconnecting. What protects the operation on the server?"
		},
		"choices": [
			{
				"id": "anexia-mobile-0",
				"label": {
					"es": "Una clave de operación e idempotencia verificada",
					"en": "An operation key and verified idempotency"
				},
				"accepted": true,
				"feedback": {
					"es": "La interfaz puede reducir dobles toques; el servidor debe controlar reintentos.",
					"en": "The interface can reduce double taps; the server must handle retries."
				}
			},
			{
				"id": "anexia-mobile-1",
				"label": {
					"es": "Deshabilitar el botón solo en la interfaz",
					"en": "Disable the button only in the interface"
				},
				"accepted": false,
				"feedback": {
					"es": "Deshabilitar el botón no detiene una reentrega de red.",
					"en": "Disabling the button does not stop a network redelivery."
				}
			},
			{
				"id": "anexia-mobile-2",
				"label": {
					"es": "Añadir un retraso fijo antes de cada reintento",
					"en": "Add a fixed delay before each retry"
				},
				"accepted": false,
				"feedback": {
					"es": "El retraso cambia cuándo llega el duplicado, pero no evita su efecto.",
					"en": "The delay changes when the duplicate arrives but does not prevent its effect."
				}
			}
		]
	},
	{
		"id": "anexia-valuation",
		"target": "review",
		"seconds": 75,
		"mechanic": "trace",
		"title": {
			"es": "Una valoración con evidencia",
			"en": "A valuation with evidence"
		},
		"briefing": {
			"es": "El modelo inmobiliario funciona bien en entrenamiento y mal con viviendas nuevas. ¿Qué investigas?",
			"en": "The property model performs well in training and poorly on new homes. What do you investigate?"
		},
		"choices": [
			{
				"id": "anexia-valuation-0",
				"label": {
					"es": "Publicar solo la métrica de entrenamiento",
					"en": "Publish only the training metric"
				},
				"accepted": false,
				"feedback": {
					"es": "La métrica de entrenamiento oculta el fallo sobre viviendas nuevas.",
					"en": "The training metric hides the failure on new homes."
				}
			},
			{
				"id": "anexia-valuation-1",
				"label": {
					"es": "Aumentar los decimales de la predicción",
					"en": "Increase decimal places in the prediction"
				},
				"accepted": false,
				"feedback": {
					"es": "Más decimales no mejoran la capacidad de predecir viviendas nuevas.",
					"en": "More decimal places do not improve predictions on new homes."
				}
			},
			{
				"id": "anexia-valuation-2",
				"label": {
					"es": "Sobreajuste, distribución y separación de evaluación",
					"en": "Overfitting, distribution and evaluation separation"
				},
				"accepted": true,
				"feedback": {
					"es": "La evaluación debe representar los inmuebles sobre los que se va a predecir.",
					"en": "Evaluation must represent the properties on which predictions will be made."
				}
			}
		]
	},
	{
		"id": "dag-tests",
		"target": "review",
		"seconds": 75,
		"mechanic": "architecture",
		"title": {
			"es": "Feedback antes de la siguiente reunión",
			"en": "Feedback before the next meeting"
		},
		"briefing": {
			"es": "La suite de integración retrasa cada cambio. ¿Qué mejora su utilidad sin debilitar las pruebas?",
			"en": "The integration suite delays every change. What improves usefulness without weakening tests?"
		},
		"choices": [
			{
