			"architecture",
			"dag-tests",
			"dag-ai"
		]
	},
	{
		"id": "system-recovery",
		"experienceId": "domingo-alonso",
		"scenario": "city",
		"missions": [
			"observe",
			"distributed",
			"application",
			"prioritize",
			"contain",
			"fix",
			"verify"
		]
	}
])
missions = Array[Dictionary]([
	{
		"id": "responsive",
		"target": "terminal",
		"seconds": 45,
		"mechanic": "bug",
		"title": {
			"es": "Maquetación contra reloj",
			"en": "Layout against the clock"
		},
		"briefing": {
			"es": "El cliente revisa la web en un móvil de 360 px. La columna fija de 960 px desborda. ¿Qué cambio probarías?",
			"en": "The client reviews the site on a 360 px phone. A fixed 960 px column overflows. What would you test?"
		},
		"choices": [
			{
				"id": "responsive-0",
				"label": {
					"es": "Ocultar todo el desbordamiento",
					"en": "Hide all overflow"
				},
				"accepted": false,
				"feedback": {
					"es": "El contenido queda recortado y parte del formulario sigue inaccesible.",
					"en": "Content is clipped and part of the form remains inaccessible."
				}
			},
			{
				"id": "responsive-1",
				"label": {
					"es": "width: 100%; max-width: 960px y revisar el contenido",
					"en": "width: 100%; max-width: 960px and check the content"
				},
				"accepted": true,
				"feedback": {
					"es": "El contenedor se adapta. Comprueba también imágenes, espaciado y navegación en móvil.",
					"en": "The container adapts. Also check images, spacing and navigation on mobile."
				}
			},
			{
				"id": "responsive-2",
				"label": {
					"es": "Reducir todo el texto a 8 px",
					"en": "Shrink all text to 8 px"
				},
				"accepted": false,
				"feedback": {
					"es": "El texto pierde legibilidad y la columna sigue siendo demasiado ancha.",
					"en": "Text becomes unreadable and the column is still too wide."
				}
			}
		]
	},
	{
		"id": "layout-a11y",
		"target": "review",
		"seconds": 75,
		"mechanic": "bug",
		"title": {
			"es": "La entrega también se usa con teclado",
			"en": "Delivery works with a keyboard too"
		},
		"briefing": {
			"es": "El menú solo se abre al pasar el ratón. ¿Cómo permites acceder sin ratón?",
			"en": "The menu only opens on hover. How do you make it usable without a mouse?"
		},
		"choices": [
			{
				"id": "layout-a11y-0",
				"label": {
					"es": "Botón real, foco visible y estado expandido",
					"en": "A real button, visible focus and expanded state"
				},
				"accepted": true,
				"feedback": {
					"es": "La interacción debe poder operarse con teclado y comunicar su estado.",
					"en": "The interaction must work with a keyboard and communicate its state."
				}
			},
			{
				"id": "layout-a11y-1",
				"label": {
					"es": "Un div con un icono más grande",
					"en": "A div with a larger icon"
				},
				"accepted": false,
				"feedback": {
					"es": "El elemento sigue sin ofrecer interacción de teclado ni comunicar su estado.",
					"en": "The element still offers no keyboard interaction or state information."
				}
			},
			{
				"id": "layout-a11y-2",
				"label": {
					"es": "Explicar que hace falta un ratón",
					"en": "Explain that a mouse is required"
				},
				"accepted": false,
				"feedback": {
					"es": "Quien usa teclado sigue sin poder abrir el menú.",
					"en": "Keyboard users still cannot open the menu."
				}
			}
		]
	},
	{
		"id": "client-handoff",
		"target": "team",
		"seconds": 75,
		"mechanic": "priority",
		"title": {
			"es": "Cerrar alcance, abrir la puerta",
			"en": "Close scope, open the door"
		},
		"briefing": {
			"es": "La web está lista. Llega un «ya que estamos» con cinco páginas nuevas. ¿Cómo cierras la entrega?",
			"en": "The site is ready. A “while you are at it” request adds five pages. How do you close delivery?"
		},
		"choices": [
			{
				"id": "client-handoff-0",
				"label": {
					"es": "Añadirlo todo sin cambiar la fecha",
					"en": "Add everything without changing the date"
				},
				"accepted": false,
				"feedback": {
					"es": "El alcance crece sin ajustar el plazo: la entrega queda comprometida.",
					"en": "Scope grows without a deadline adjustment, putting delivery at risk."
				}
			},
			{
				"id": "client-handoff-1",
				"label": {
					"es": "Ignorar el mensaje",
					"en": "Ignore the message"
				},
				"accepted": false,
				"feedback": {
					"es": "El cliente no sabe qué incluye la entrega y no puede validarla.",
					"en": "The client does not know what delivery includes and cannot validate it."
				}
			},
			{
				"id": "client-handoff-2",
				"label": {
					"es": "Validar lo acordado y presupuestar la ampliación",
					"en": "Validate the agreed scope and estimate the extension"
				},
				"accepted": true,
				"feedback": {
					"es": "Una entrega verificable y un alcance explícito protegen al cliente y al proyecto.",
					"en": "Verifiable delivery and explicit scope protect the client and the project."
				}
			}
		]
	},
	{
		"id": "xul-learn",
		"target": "team",
		"seconds": 75,
		"mechanic": "priority",
		"title": {
			"es": "Un componente por conocer",
			"en": "An unfamiliar component"
		},
		"briefing": {
			"es": "Debes corregir un fallo en un componente Android que todavía no conoces. ¿Por dónde empiezas?",
			"en": "You must fix a failure in an Android component you do not yet know. Where do you start?"
		},
		"choices": [
			{
				"id": "xul-learn-0",
				"label": {
					"es": "Reescribirlo de memoria",
					"en": "Rewrite it from memory"
				},
				"accepted": false,
				"feedback": {
					"es": "La reescritura elimina comportamiento que todavía no has identificado.",
					"en": "The rewrite removes behavior you have not yet identified."
				}
			},
			{
				"id": "xul-learn-1",
				"label": {
					"es": "Reproducir el caso y pedir una revisión guiada",
					"en": "Reproduce the case and ask for a guided review"
				},
				"accepted": true,
				"feedback": {
					"es": "Un ejemplo mínimo y una revisión convierten la tarea en aprendizaje compartido.",
					"en": "A minimal example and a review turn the task into shared learning."
				}
			},
			{
				"id": "xul-learn-2",
				"label": {
					"es": "Cambiar varias cosas hasta que compile",
					"en": "Change several things until it builds"
				},
				"accepted": false,
				"feedback": {
					"es": "Aunque compile, no sabes qué cambio corrige el fallo ni qué ha roto.",
					"en": "Even if it builds, you cannot tell which change fixes the bug or what broke."
				}
			}
		]
	},
	{
		"id": "xul-lifecycle",
		"target": "terminal",
		"seconds": 75,
		"mechanic": "bug",
		"title": {
			"es": "El museo gira",
			"en": "The museum rotates"
		},
		"briefing": {
			"es": "Al girar el móvil, la ficha seleccionada vuelve a la primera. ¿Qué hay que conservar?",
			"en": "Rotating the phone resets the selected exhibit to the first one. What should survive?"
		},
		"choices": [
			{
				"id": "xul-lifecycle-0",
				"label": {
					"es": "La selección como estado restaurable",
					"en": "The selection as restorable state"
				},
				"accepted": true,
				"feedback": {
					"es": "Conserva el identificador seleccionado y restaura la vista desde ese estado.",
					"en": "Keep the selected identifier and restore the view from that state."
				}
			},
			{
				"id": "xul-lifecycle-1",
				"label": {
					"es": "Una referencia permanente a la pantalla destruida",
					"en": "A permanent reference to the destroyed screen"
				},
				"accepted": false,
				"feedback": {
					"es": "La referencia apunta a una pantalla destruida y no restaura la nueva.",
					"en": "The reference points to a destroyed screen and does not restore the new one."
				}
			},
			{
				"id": "xul-lifecycle-2",
				"label": {
					"es": "La orientación bloqueada como único arreglo",
					"en": "Locked orientation as the only fix"
				},
				"accepted": false,
				"feedback": {
					"es": "Bloquear el giro oculta el síntoma; al recrear la pantalla se pierde la selección.",
					"en": "Locking rotation hides the symptom; recreating the screen still loses the selection."
				}
			}
		]
	},
	{
		"id": "xul-review",
		"target": "review",
		"seconds": 75,
		"mechanic": "priority",
		"title": {
			"es": "Preparar el cambio para revisión",
			"en": "Prepare the change for review"
		},
		"briefing": {
			"es": "Has corregido un fallo de navegación. Otra persona debe comprobarlo antes de integrar el cambio. ¿Qué le entregas?",
			"en": "You fixed a navigation failure. Someone else must check it before merging the change. What do you hand over?"
		},
		"choices": [
			{
				"id": "xul-review-0",
				"label": {
					"es": "Solo una captura de pantalla",
					"en": "Just a screenshot"
				},
				"accepted": false,
				"feedback": {
					"es": "La captura no permite repetir el caso ni verificar la corrección.",
					"en": "The screenshot cannot reproduce the case or verify the fix."
				}
			},
			{
				"id": "xul-review-1",
				"label": {
					"es": "Que funcione una vez en mi móvil",
					"en": "It worked once on my phone"
				},
				"accepted": false,
				"feedback": {
					"es": "Una ejecución aislada no comprueba que el fallo haya desaparecido.",
					"en": "One isolated run does not verify that the failure is gone."
				}
			},
			{
				"id": "xul-review-2",
				"label": {
					"es": "Caso reproducible, cambio pequeño y revisión",
					"en": "A reproducible case, a small change and a review"
				},
				"accepted": true,
				"feedback": {
					"es": "El equipo reproduce el caso y verifica el cambio antes de integrarlo.",
					"en": "The team reproduces the case and verifies the change before merging it."
				}
			}
		]
	},
	{
		"id": "signlab-coordinates",
		"target": "exhibit",
		"seconds": 75,
		"mechanic": "routing",
		"title": {
			"es": "Una imagen, muchas zonas",
			"en": "One image, many regions"
		},
		"briefing": {
			"es": "La imagen del museo se reduce a la mitad. Los puntos táctiles siguen en coordenadas originales. ¿Cómo los alineas?",
			"en": "The museum image is scaled down by half. Touch points still use original coordinates. How do you align them?"
		},
		"choices": [
			{
				"id": "signlab-coordinates-0",
				"label": {
					"es": "Transformar el toque al sistema de coordenadas de la imagen",
					"en": "Transform the touch into image coordinates"
				},
				"accepted": true,
				"feedback": {
					"es": "Aplica la transformación inversa de escala y desplazamiento antes de consultar las zonas.",
					"en": "Apply the inverse scale and offset transformation before looking up regions."
				}
			},
			{
				"id": "signlab-coordinates-1",
				"label": {
					"es": "Duplicar todas las zonas a ojo",
					"en": "Duplicate every region by eye"
				},
				"accepted": false,
				"feedback": {
					"es": "El ajuste manual solo coincide en una escala y vuelve a fallar al redimensionar.",
					"en": "The manual adjustment only matches one scale and fails again when resized."
				}
			},
			{
				"id": "signlab-coordinates-2",
				"label": {
					"es": "Escalar el tamaño de las zonas sin mover su origen",
					"en": "Scale region sizes without moving their origin"
				},
				"accepted": false,
				"feedback": {
					"es": "Cambiar solo el tamaño de las zonas deja sus posiciones desalineadas.",
					"en": "Changing only region sizes leaves their positions misaligned."
				}
			}
		]
	},
	{
		"id": "signlab-overlap",
		"target": "review",
		"seconds": 75,
		"mechanic": "bug",
		"title": {
			"es": "Dos salas bajo el mismo dedo",
			"en": "Two rooms under one finger"
		},
		"briefing": {
			"es": "Dos regiones interactivas se solapan. El visitante recibe dos acciones. ¿Qué falta definir?",
			"en": "Two interactive regions overlap. A visitor gets two actions. What must be defined?"
		},
		"choices": [
			{
				"id": "signlab-overlap-0",
				"label": {
					"es": "Un retraso aleatorio",
					"en": "A random delay"
				},
				"accepted": false,
				"feedback": {
					"es": "El retraso no decide qué región gana: ambas acciones siguen siendo posibles.",
					"en": "The delay does not decide which region wins: both actions remain possible."
				}
			},
			{
				"id": "signlab-overlap-1",
				"label": {
					"es": "Una prioridad determinista y una sola acción por gesto",
					"en": "Deterministic priority and one action per gesture"
				},
				"accepted": true,
				"feedback": {
					"es": "Una regla de prioridad probada evita respuestas ambiguas en los bordes.",
					"en": "A tested priority rule avoids ambiguous responses at boundaries."
				}
			},
			{
				"id": "signlab-overlap-2",
				"label": {
					"es": "Desactivar todas las regiones",
					"en": "Disable every region"
				},
				"accepted": false,
				"feedback": {
					"es": "Evitas la duplicidad, pero dejas al visitante sin interacción.",
					"en": "You avoid duplicate actions but leave visitors with no interaction."
				}
			}
		]
	},
	{
		"id": "signlab-delivery",
		"target": "team",
		"seconds": 75,
		"mechanic": "trace",
		"title": {
			"es": "Museo listo para abrir",
			"en": "Museum ready to open"
		},
		"briefing": {
			"es": "El componente ya responde. ¿Qué conjunto de pruebas representa mejor la visita?",
			"en": "The component responds now. Which checks best represent a visit?"
		},
		"choices": [
			{
				"id": "signlab-delivery-0",
				"label": {
					"es": "Solo tocar el centro una vez",
					"en": "Only tap the center once"
				},
				"accepted": false,
				"feedback": {
					"es": "La prueba no detecta errores en los bordes ni al cambiar de escala.",
					"en": "The test misses boundary and scaling errors."
				}
			},
			{
				"id": "signlab-delivery-1",
				"label": {
					"es": "Solo comprobar que instala",
					"en": "Only check installation"
				},
				"accepted": false,
				"feedback": {
					"es": "La instalación no verifica que los gestos activen la región correcta.",
					"en": "Installation does not verify that gestures activate the correct region."
				}
			},
			{
				"id": "signlab-delivery-2",
				"label": {
					"es": "Bordes, escalas y gestos repetidos",
					"en": "Boundaries, scales and repeated gestures"
				},
				"accepted": true,
				"feedback": {
					"es": "Verifica las interacciones reales, incluidos los casos límite.",
					"en": "Verify real interactions, including edge cases."
				}
			}
		]
	},
	{
		"id": "school-permissions",
		"target": "server",
		"seconds": 75,
		"mechanic": "trace",
		"title": {
			"es": "La llave de la sala de servidores",
			"en": "The server room key"
		},
		"briefing": {
			"es": "Una cuenta de aula no abre una carpeta compartida. La red responde. ¿Qué revisas?",
			"en": "A classroom account cannot open a shared folder. The network responds. What do you inspect?"
		},
		"choices": [
			{
				"id": "school-permissions-0",
				"label": {
					"es": "Dar administración a todo el alumnado",
					"en": "Give every pupil admin rights"
				},
				"accepted": false,
				"feedback": {
					"es": "Abres permisos innecesarios sin identificar el acceso que falta.",
					"en": "You grant unnecessary permissions without identifying the missing access."
				}
			},
			{
				"id": "school-permissions-1",
				"label": {
					"es": "La cuenta, su grupo y los permisos necesarios",
					"en": "The account, its group and required permissions"
				},
				"accepted": true,
				"feedback": {
					"es": "Comprueba permisos con una cuenta representativa y concede solo lo necesario.",
					"en": "Check permissions with a representative account and grant only what is needed."
				}
			},
			{
				"id": "school-permissions-2",
				"label": {
					"es": "Quitar la contraseña del servidor",
					"en": "Remove the server password"
				},
				"accepted": false,
				"feedback": {
					"es": "Eliminar la contraseña expone el servidor y no corrige los permisos de la carpeta.",
					"en": "Removing the password exposes the server and does not fix folder permissions."
				}
			}
		]
	},
	{
		"id": "school-backup",
		"target": "review",
		"seconds": 75,
		"mechanic": "priority",
		"title": {
			"es": "Antes de tocar el servidor",
			"en": "Before changing the server"
		},
		"briefing": {
			"es": "Una actualización requiere reinicio durante las clases. ¿Cómo la preparas?",
			"en": "An update requires a reboot during lessons. How do you prepare it?"
		},
		"choices": [
			{
				"id": "school-backup-0",
				"label": {
					"es": "Acordar ventana, verificar copia y planificar recuperación",
					"en": "Agree a window, verify the backup and plan recovery"
				},
				"accepted": true,
				"feedback": {
					"es": "La continuidad de las clases necesita coordinación y una recuperación comprobable.",
					"en": "Lesson continuity needs coordination and verifiable recovery."
				}
			},
			{
				"id": "school-backup-1",
				"label": {
					"es": "Reiniciar sin avisar",
					"en": "Reboot without notice"
				},
				"accepted": false,
				"feedback": {
					"es": "El reinicio interrumpe las clases sin dar tiempo a guardar el trabajo.",
					"en": "The reboot interrupts lessons without time to save work."
				}
			},
			{
				"id": "school-backup-2",
				"label": {
					"es": "Borrar los registros para liberar espacio",
					"en": "Delete logs to free space"
				},
				"accepted": false,
				"feedback": {
					"es": "Pierdes registros útiles para diagnosticar un fallo de actualización.",
					"en": "You lose logs needed to diagnose an update failure."
				}
			}
		]
	},
	{
		"id": "school-inventory",
		"target": "team",
		"seconds": 75,
		"mechanic": "priority",
		"title": {
			"es": "El siguiente turno también cuenta",
			"en": "The next shift matters too"
		},
		"briefing": {
			"es": "Has recuperado el servicio del aula. ¿Qué dejas al equipo?",
			"en": "You restored the classroom service. What do you leave for the team?"
		},
		"choices": [
			{
				"id": "school-inventory-0",
