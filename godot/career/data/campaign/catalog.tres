	{
		"id": "prioritize",
		"mechanic": "priority",
		"title": {
			"es": "04 / Prioriza",
			"en": "04 / Prioritize"
		},
		"briefing": {
			"es": "Clientes afectados, pipeline rojo y una PR pendiente. Ordena: pide cobertura al equipo, contiene el incidente, recupera el pipeline y revisa la PR.",
			"en": "Customers are affected, the pipeline is red and a PR is pending. Order: ask the team for cover, contain the incident, recover the pipeline and review the PR."
		},
		"sequence": [
			"team",
			"incident",
			"ci",
			"pr"
		],
		"choices": [
			{
				"id": "pr",
				"label": {
					"es": "PR pendiente",
					"en": "Pending PR"
				},
				"feedback": {
					"es": "La revisión vuelve a tener su espacio.",
					"en": "Review gets its time again."
				},
				"accepted": true
			},
			{
				"id": "ci",
				"label": {
					"es": "Pipeline fallando",
					"en": "Failing pipeline"
				},
				"feedback": {
					"es": "Restauras la vía de entrega después de contener el impacto.",
					"en": "You restore delivery after containing impact."
				},
				"accepted": true
			},
			{
				"id": "team",
				"label": {
					"es": "Pedir cobertura al equipo",
					"en": "Ask the team for cover"
				},
				"feedback": {
					"es": "Coordinación y comunicación delegadas: ya no estás solo.",
					"en": "Coordination and communication delegated: you are no longer alone."
				},
				"accepted": true
			},
			{
				"id": "incident",
				"label": {
					"es": "Contener producción",
					"en": "Contain production"
				},
				"feedback": {
					"es": "La prioridad es limitar el daño actual a clientes.",
					"en": "The priority is limiting current customer impact."
				},
				"accepted": true
			}
		]
	},
	{
		"id": "contain",
		"mechanic": "architecture",
		"title": {
			"es": "05 / Contén",
			"en": "05 / Contain"
		},
		"briefing": {
			"es": "Los eventos duplicados multiplican efectos y una caché sirve valores obsoletos. Existe un modo degradado probado. Elige una contención reversible.",
			"en": "Duplicate events multiply effects and a cache serves stale values. A tested degraded mode exists. Choose reversible containment."
		},
		"choices": [
			{
				"id": "degrade",
				"label": {
					"es": "Activar modo degradado y pausar el consumidor afectado",
					"en": "Enable degraded mode and pause the affected consumer"
				},
				"feedback": {
					"es": "El alcance baja. Conservas eventos para reproducirlos después de corregir la idempotencia.",
					"en": "Impact narrows. You retain events for replay after fixing idempotency."
				},
				"accepted": true
			},
			{
				"id": "delete",
				"label": {
					"es": "Borrar la cola y todos los datos",
					"en": "Delete the queue and all data"
				},
				"feedback": {
					"es": "Destruirías información necesaria para recuperar el servicio.",
					"en": "You would destroy information needed for recovery."
				},
				"accepted": false
			}
		]
	},
	{
		"id": "fix",
		"mechanic": "routing",
		"title": {
			"es": "06 / Corrige",
			"en": "06 / Fix"
		},
		"briefing": {
			"es": "Construye una ruta de procesamiento que tolere reentregas: recibir, comprobar Inbox, aplicar una vez e invalidar caché. En esta simulación, Inbox y efecto comparten transacción.",
			"en": "Build a processing route that tolerates redelivery: receive, check Inbox, apply once and invalidate cache. In this simulation, Inbox and effect share a transaction."
		},
		"sequence": [
			"receive",
			"inbox",
			"apply",
			"cache"
		],
		"choices": [
			{
				"id": "cache",
				"label": {
					"es": "Invalidar caché",
					"en": "Invalidate cache"
				},
				"feedback": {
					"es": "La lectura siguiente vuelve a consultar la fuente.",
					"en": "The next read consults the source again."
				},
				"accepted": true
			},
			{
				"id": "apply",
				"label": {
					"es": "Aplicar efecto una vez",
					"en": "Apply effect once"
				},
				"feedback": {
					"es": "Una entrega duplicada no duplica el efecto.",
					"en": "A duplicate delivery does not duplicate the effect."
				},
				"accepted": true
			},
			{
				"id": "receive",
				"label": {
					"es": "Recibir evento",
					"en": "Receive event"
				},
				"feedback": {
					"es": "Cada evento conserva su identificador.",
					"en": "Every event retains its identifier."
				},
				"accepted": true
			},
			{
				"id": "inbox",
				"label": {
					"es": "Comprobar Inbox",
					"en": "Check Inbox"
				},
				"feedback": {
					"es": "La transacción protege la deduplicación y el efecto.",
					"en": "The transaction protects deduplication and the effect."
				},
				"accepted": true
			}
		]
	},
	{
		"id": "verify",
		"mechanic": "priority",
		"title": {
			"es": "07 / Verifica",
			"en": "07 / Verify"
		},
		"briefing": {
			"es": "El cambio está aplicado. Ordena la recuperación: pruebas de reentrega, canary con métricas, reanudar tráfico y comunicar seguimiento.",
			"en": "The change is applied. Order recovery: redelivery tests, a canary with metrics, resume traffic and communicate follow-up."
		},
		"sequence": [
			"test",
			"canary",
			"resume",
			"communicate"
		],
		"choices": [
			{
				"id": "resume",
				"label": {
					"es": "Reanudar tráfico y consumidores",
					"en": "Resume traffic and consumers"
				},
				"feedback": {
					"es": "La recuperación se amplía de forma controlada.",
					"en": "Recovery expands in a controlled way."
				},
				"accepted": true
			},
			{
				"id": "communicate",
				"label": {
					"es": "Comunicar recuperación y seguimiento",
					"en": "Communicate recovery and follow-up"
				},
				"feedback": {
					"es": "Sistema recuperado. La carrera sigue en curso.",
					"en": "System recovered. The career remains in progress."
				},
				"accepted": true
			},
			{
				"id": "test",
				"label": {
					"es": "Probar reentregas y consistencia",
					"en": "Test redelivery and consistency"
				},
				"feedback": {
					"es": "Las pruebas verifican el comportamiento, no solo el despliegue.",
					"en": "Tests verify behavior, not just deployment."
				},
				"accepted": true
			},
			{
				"id": "canary",
				"label": {
					"es": "Canary · comprobar errores y latencia",
					"en": "Canary · check errors and latency"
				},
				"feedback": {
					"es": "La muestra recupera valores estables en este simulador.",
					"en": "The sample returns to stable values in this simulator."
				},
				"accepted": true
			}
		]
	}
])
