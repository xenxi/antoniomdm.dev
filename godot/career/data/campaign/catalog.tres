		"experienceId": "nokia",
		"scenario": "network",
		"missions": [
			"network",
			"nokia-connectivity",
			"nokia-snake",
			"nokia-geometry"
		]
	},
	{
		"id": "vector-itc",
		"experienceId": "vector-itc",
		"scenario": "office",
		"missions": [
			"pipeline",
			"vector-report",
			"vector-nlp",
			"vector-workflow"
		]
	},
	{
		"id": "anexia",
		"experienceId": "anexia",
		"scenario": "city",
		"missions": [
