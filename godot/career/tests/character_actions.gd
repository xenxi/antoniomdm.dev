extends SceneTree
var failures = 0
func check(value: bool, message: String) -> void:
	if not value: failures += 1; push_error(message)

func _initialize() -> void:
	call_deferred("run")

func run() -> void:
	var coffee = CoffeeChallenge.new()
	check(not coffee.start(false), "Challenge requires three coffees")
	check(coffee.drink(), "First sip accepted")
	check(not coffee.drink(), "Repeated sip is debounced")
	coffee.tick(2.0)
	coffee.drink()
	coffee.tick(2.0)
	coffee.drink()
	check(coffee.start(false), "Third coffee unlocks challenge")
	coffee.hit()
	check(coffee.misses == 1 and coffee.hits == 0, "Outside target is a miss")
	coffee.tick(13.0)
	check(coffee.phase == "lost", "Timed challenge expires")
	check(coffee.start(true), "Can retry without time or precision")
	coffee.tick(100.0)
	check(coffee.phase == "playing", "Untimed mode does not expire")
	for i in 5:
		coffee.hit()
		coffee.tick(.3)
	check(coffee.phase == "won" and coffee.hits == 5, "Five valid captures win")
	coffee.hit()
	check(coffee.hits == 5, "Finished round ignores further inputs")
	var actions = root.get_node("CharacterActions")
	var state = root.get_node("GameState")
	state.set_active(true)
	state.reduced_motion = false
	actions.motion(false)
	actions._process(12.1)
	check(actions.action == "idle", "Idle gesture starts after inactivity")
	actions.motion(true)
	check(actions.action.is_empty(), "Walking interrupts the idle gesture")
	actions.play("guitar", 5.0)
	state.set_active(false)
	actions._process(3.0)
	check(actions.elapsed == 0.0, "Pause freezes action clock")
	state.set_active(true)
	state.reduced_motion = true
	actions._process(.5)
	check(actions.frame() == 0, "Reduced motion holds a single pose")
	for id in actions.ACTIONS:
		check(ActionArt.texture(id) != null and ActionArt.region(id, 7).end.x == 2048, "Each action has eight complete atlas frames")
	state.reduced_motion = false
	actions.play("coffee", 2.0)
	actions._process(1.9)
	check(actions.frame() == 7, "Coffee finishes its sip instead of looping back to lifting the mug")
	actions.play("guitar", 5.0)
	actions._process(.25)
	var phase = actions.elapsed
	actions.play("guitar", 5.0)
	check(actions.elapsed == phase, "Repeated interaction does not rewind a continuous action")
	var gait = CharacterMotion.new()
	gait.advance(.1, true, 1.5, false, true)
	check(gait.frame() == 3, "Walking advances according to distance")
	gait.advance(.04, false, 0.0, false, true)
	check(gait.frame() == 3 and gait.walking(), "Brief input gaps preserve the stride")
	gait.advance(.1, true, .5, false, true)
	check(gait.frame() == 4, "Next movement continues the opposite half of the stride")
	gait.advance(1.0, false, 0.0, false, false)
	check(gait.frame() == 4, "Pause freezes locomotion presentation")
	gait.advance(.2, false, 0.0, false, true)
	check(not gait.walking(), "Stopping settles into idle")
	gait.advance(.1, true, 1.0, true, true)
	check(not gait.walking() and gait.offset_y() == 0.0 and not gait.blink(), "Reduced motion removes gait, breathing and blinking")
	actions.reset_world()
	print("Character actions and coffee: ", "PASS" if failures == 0 else "FAIL")
	quit(0 if failures == 0 else 1)
