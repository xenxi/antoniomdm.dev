---
import PrivacyControls from './PrivacyControls.astro';
import OutOfScopeLayout from '../layouts/OutOfScopeLayout.astro';
import { contactInfo, contactMailto } from '../data/contact';
import {
  PRIVACY_UPDATED,
  privacyCanonical,
  privacyCopy,
} from '../data/privacy';
import type { Locale } from '../i18n/core';

interface Props { locale: Locale }

const { locale } = Astro.props;
const en = locale === 'en';
const copy = privacyCopy[locale];
const alternateLocale: Locale = en ? 'es' : 'en';
const portfolio = en ? '/en/' : '/';
---

<OutOfScopeLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
  canonical={privacyCanonical(locale)}
  alternate={{ locale: alternateLocale, href: privacyCanonical(alternateLocale) }}
  kind="website"
  variant="legal"
>
  <article class="privacy-page">
    <header class="privacy-header">
      <a class="oos-back" href={portfolio}>← {copy.back}</a>
      <p class="privacy-kicker">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="privacy-introduction">{copy.introduction}</p>
      <p class="privacy-updated"><strong>{copy.updatedLabel}:</strong> <time datetime={PRIVACY_UPDATED}>{copy.updated}</time></p>
    </header>

    <div class="privacy-layout">
      <nav class="privacy-contents" aria-labelledby="privacy-contents-title">
        <p id="privacy-contents-title">{copy.contents}</p>
        <ol>
          {copy.sections.map(section => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
        </ol>
      </nav>

      <div class="privacy-content">
        {copy.sections.map((section, index) => (
          <>
            {index === 8 && <PrivacyControls copy={copy} />}
            <section id={section.id} aria-labelledby={`${section.id}-title`}>
              <h2 id={`${section.id}-title`}>{section.title}</h2>
              {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
              {section.bullets && <ul>{section.bullets.map(item => <li>{item}</li>)}</ul>}
              {section.id === (en ? 'contact' : 'contacto') && (
                <div class="privacy-resources">
                  <p><a href={contactMailto}>{contactInfo.email}</a></p>
                  <ul>
                    <li><a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">{en ? 'Google Privacy Policy' : 'Política de Privacidad de Google'} ↗</a></li>
                    <li><a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">{en ? 'How Google uses information from partner sites' : 'Cómo utiliza Google la información de sitios de partners'} ↗</a></li>
                    <li><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">{en ? 'GitHub Privacy Statement' : 'Declaración de privacidad de GitHub'} ↗</a></li>
                    <li><a href="https://www.aepd.es/" target="_blank" rel="noopener noreferrer">{en ? 'Spanish Data Protection Agency (AEPD)' : 'Agencia Española de Protección de Datos (AEPD)'} ↗</a></li>
                  </ul>
                </div>
              )}
            </section>
          </>
        ))}
      </div>
    </div>
  </article>
</OutOfScopeLayout>
