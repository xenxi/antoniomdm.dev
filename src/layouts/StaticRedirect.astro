---
interface Props { target: string }
const { target } = Astro.props;
const absolute = `https://antoniomdm.dev${target}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={absolute} />
    <title>Redirigiendo / Redirecting · AntoñiOS</title>
    <script is:inline set:html={`location.replace(${JSON.stringify(target)} + location.search + location.hash)`} />
  </head>
  <body>
    <main>
      <p lang="es">Esta ruta se conserva por compatibilidad. <a href={target}>Continuar a la página canónica</a>.</p>
      <p lang="en">This route is retained for compatibility. <a href={target}>Continue to the canonical page</a>.</p>
    </main>
  </body>
</html>
