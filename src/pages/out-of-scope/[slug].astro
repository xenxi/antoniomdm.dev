---
import StaticRedirect from '../../layouts/StaticRedirect.astro';
import { getOutOfScopeEntries } from '../../data/out-of-scope';
export async function getStaticPaths() {
  return (await getOutOfScopeEntries('es')).map(entry => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { slug } = Astro.params;
---
<StaticRedirect target={`/blog/${slug}/`} />
